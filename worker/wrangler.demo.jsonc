{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edital-monitor-crud-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",

  "workers_dev": true,
  "preview_urls": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edital-monitor-demo",
      "database_id": "1f04434d-d4c0-493f-ab92-bd3dde78ea07"
    }
  ],
  "vars": {
    "DAILY_SEARCH_LIMIT": "30",
    "ALLOWED_ORIGIN": "http://localhost:3000"
  },
  "secrets": {
    "required": [
      "INGEST_TOKEN",
      "RATE_LIMIT_SALT",
      "AUTH_SECRET"
    ]
  }
}
