{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edital-monitor-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edital-monitor",
      "database_id": "7cfcb301-6c96-4290-9f70-c23fdf416262"
    }
  ],
  "vars": {
    "DAILY_SEARCH_LIMIT": "30",
    "ALLOWED_ORIGIN": "*"
  },
  "secrets": {
    "required": [
      "INGEST_TOKEN",
      "RATE_LIMIT_SALT"
    ]
  }
}
